{% assign repo_url = include.repository.repo | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign repo_label = repo_url.last %}
{% else %}
  {% assign repo_label = include.repository.repo %}
{% endif %}

<div class="repo p-2 w-100">
  <a class="repo-card card h-100 hoverable" href="https://github.com/{{ include.repository.repo }}">
    <div class="card-body">
      <h3 class="repo-name"><i class="fa-brands fa-github"></i> {{ repo_label }}</h3>
      <p class="repo-desc">{{ include.repository.description }}</p>
      {% if include.repository.language %}
        <span class="repo-lang">{{ include.repository.language }}</span>
      {% endif %}
    </div>
  </a>
</div>
